DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sorteio?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessao autenticada do Instagram gerada por `npm run instagram:auth`.
# Nao commitar esse arquivo. Ele contem cookies/sessao autenticada.
INSTAGRAM_AUTH_STATE_PATH="storage/instagram-auth.json"

# Limites operacionais da captura incremental via Playwright.
INSTAGRAM_CAPTURE_MAX_ITERATIONS="150"
INSTAGRAM_CAPTURE_NO_GROWTH_LIMIT="8"
INSTAGRAM_CAPTURE_SCROLL_DELAY_MS="900"
INSTAGRAM_CAPTURE_TIMEOUT_MS="180000"
